{
  "name": "pixelboss",
  "version": "0.1.0",
  "private": true,
  "description": "PixelBoss (AI Virtual Company) - 복셀 3D 가상 오피스 기반 멀티 에이전트 프로젝트 관리 대시보드",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"pnpm --filter @pixelboss/server dev\" \"pnpm --filter @pixelboss/web dev\"",
    "dev:server": "pnpm --filter @pixelboss/server dev",
    "dev:web": "pnpm --filter @pixelboss/web dev",
    "build": "pnpm --filter @pixelboss/web build",
    "typecheck": "pnpm -r typecheck",
    "fixtures": "node scripts/make-fixtures.mjs",
    "verify": "node scripts/verify-e2e.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "ci": "node check.mjs types && node check.mjs lint"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "playwright": "1.56.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty",
      "esbuild",
      "@parcel/watcher",
      "vue-demi"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
